{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
      }
    },
  "AllowedHosts": "*",
  "Auth0": {
    "Authority": "https://dev-i3ignzy3cmq75oa4.us.auth0.com",
    "Audience": "https://blazorstandalonedemoapi.com"
  },
  "ApiGateway": {
    "Routes": {
      "UserApiRoute": {
        "ClusterId": "UserApiCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "user-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "api/{**catch-all}"
          }
        ]
      },
      "UserApiAddUserRoute": {
        "ClusterId": "UserApiCluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "user-api/user/add",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "PathPattern": "api/user/add"
          }
        ]
      },
      "WeatherApiRoute": {
        "ClusterId": "WeatherApiCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "weather-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "api/{**catch-all}"
          }
        ]
      },
      "WeatherApiPredictionByIdRoute": {
        "ClusterId": "WeatherApiCluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "weather-api/weatherforecast/predictions/{id}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "api/weatherforecast/predictions/{id}"
          }
        ]
      }
    },
    "Clusters": {
      "UserApiCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://userapi:5004/"
          }
        }
      },
      "WeatherApiCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://weatherapi:5006/"
          }
        }
      }
    }
  }
}